# Server port
PORT=8787
# Secret used to sign auth tokens. CHANGE THIS in production (any long random string).
JWT_SECRET=change-me-to-a-long-random-string
# Base domain used for game subdomains: <slug>.<BASE_DOMAIN>
# Local dev: *.localhost resolves to 127.0.0.1 in Chrome/Firefox/Edge automatically.
BASE_DOMAIN=localhost:8787
# Where SQLite DB and uploaded files are stored
DATA_DIR=./data
# Optional: server-side OpenRouter key. If unset, each user supplies their own key in the AI panel.
OPENROUTER_API_KEY=
# Optional: OpenAI-compatible base URL (use a proxy if openrouter.ai is blocked in your region)
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Public URL of the studio (sent to OpenRouter as HTTP-Referer)
PUBLIC_URL=http://localhost:8787
