{
  "version": 3,
  "routes": [
    {
      "src": "^/(assets|samples|templates)/(.*)$",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable",
        "access-control-allow-origin": "*"
      },
      "continue": true
    },
    {
      "src": "^/sw\\.js$",
      "headers": {
        "cache-control": "no-cache"
      },
      "continue": true
    },
    {
      "src": "^/api/(.*)$",
      "dest": "/api?__p=/api/$1"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/embed/.*$",
      "dest": "/player.html"
    },
    {
      "src": "^/(?!api/).*$",
      "dest": "/index.html"
    }
  ]
}